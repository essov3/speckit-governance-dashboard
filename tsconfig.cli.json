{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true
  },
  "include": ["src/cli", "src/core"]
}
